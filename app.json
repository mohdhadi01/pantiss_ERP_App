{
  "expo": {
    "name": "Pantiss ERP",
    "slug": "pantiss-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pantiss-mark.png",
    "scheme": "pantisserp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/pantiss-mark.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F0",
        "foregroundImage": "./assets/images/pantiss-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/pantiss-mark.png",
      "name": "Pantiss ERP",
      "backgroundColor": "#09090b",
      "themeColor": "#09090b"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/pantiss-mark.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}